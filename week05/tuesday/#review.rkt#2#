;; count-at-least : List-of-students Number -> Number
;; эцсийн оноо нь n ба түүнээс дээш сурагчийн тоо
(define (count-at-least los n)
  (cond
    [(empty? los) 0]
    [else
     (if (>= (student-score (first los)) n)
         (+ 1 (count-at-least (rest los) n))
         (count-at-least (rest los) n))]))
(check-expect (count-at-least empty 50) 0)
(check-expect (count-at-least students 80) 2)
(check-expect (count-at-least students 0) 4)
;; names-with-grade : List-of-students String -> List-of-strings
;; өгөгдсөн үнэлгээтэй сурагчдын нэр

(define (names-with-grade los g)
  (cond
    [(empty? los) empty]
    [else
     (if (string=? (student-grade (first los)) g)
         (cons (student-name (first los)) (names-with-grade (rest los) g))
         (names-with-grade (rest los) g))]))
(require 2htdp/image)

;; grade-row : List-of-students -> Image
;; сурагч бүрт радиус 10 тойрог: тэнцсэн бол ногоон, үгүй бол улаан
(define (grade-row grade)
  (cond
    [(empty? grade) empty-image]
    [else
     (beside (if (student-passing? (first grade))
                 (circle 10 "solid" "green")
                 (circle 10 "solid" "red"))
             (grade-row (rest grade)))]))